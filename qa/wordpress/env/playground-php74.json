{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "login": true,
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "WP_DEBUG": true,
        "WP_DEBUG_DISPLAY": false,
        "WP_DEBUG_LOG": "/wordpress/wp-content/mu-plugins/debug.log"
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "bundled",
        "path": "/generation-maine.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "permalink_structure": "/%postname%/",
        "blogname": "Generation Maine"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; wp_set_current_user( 1 ); $args = array( 9, '/media' ); include get_theme_file_path( 'bin/seed-creators.php' ); flush_rewrite_rules();"
    }
  ],
  "preferredVersions": {
    "php": "7.4",
    "wp": "6.5"
  }
}