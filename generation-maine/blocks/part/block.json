{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "generation-maine/part",
	"title": "Generation Maine Part",
	"category": "design",
	"icon": "admin-site-alt3",
	"description": "A piece of the page drawn by the theme: the logo link, the phone menu button or the Maine mural.",
	"textdomain": "generation-maine",
	"attributes": {
		"name": { "type": "string", "default": "logo", "enum": [ "logo", "menu", "mural" ] }
	},
	"supports": { "html": false, "inserter": false, "reusable": false, "lock": false, "customClassName": false, "className": false },
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
