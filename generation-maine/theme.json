{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"title": "Generation Maine",
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": false,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"text": false,
			"background": false,
			"link": false,
			"heading": false,
			"button": false,
			"caption": false,
			"palette": [
				{
					"slug": "navy",
					"name": "Navy (bar, footer, type)",
					"color": "#0F2E4D"
				},
				{
					"slug": "blue",
					"name": "Blue (hero)",
					"color": "#0556A5"
				},
				{
					"slug": "gold",
					"name": "Gold (the accent)",
					"color": "#FAC800"
				},
				{
					"slug": "tint",
					"name": "Light blue (creators field)",
					"color": "#EAF1F8"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#FFFFFF"
				}
			]
		},
		"layout": {
			"contentSize": "1280px",
			"wideSize": "1280px"
		},
		"spacing": {
			"padding": false,
			"margin": false,
			"blockGap": false
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": false,
			"fluid": false,
			"fontSizes": [],
			"fontStyle": false,
			"fontWeight": false,
			"letterSpacing": false,
			"lineHeight": false,
			"textDecoration": false,
			"textTransform": false,
			"writingMode": false,
			"dropCap": false,
			"textColumns": false,
			"textIndent": false
		},
		"shadow": {
			"defaultPresets": false,
			"presets": []
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": false
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "#FFFFFF",
			"text": "#0F2E4D"
		},
		"spacing": {
			"blockGap": "0px",
			"padding": {
				"top": "0",
				"right": "0",
				"bottom": "0",
				"left": "0"
			}
		},
		"typography": {
			"fontFamily": "'DM Sans',system-ui,sans-serif",
			"lineHeight": "1.55"
		},
		"elements": {
			"button": {
				"border": {
					"radius": "0"
				},
				"color": {
					"background": "#FAC800",
					"text": "#0F2E4D"
				},
				"typography": {
					"fontFamily": "Michroma,Eurostile,system-ui,sans-serif"
				},
				":hover": {
					"color": {
						"background": "#FFD633",
						"text": "#0F2E4D"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "'Bricolage Grotesque',system-ui,sans-serif",
					"fontWeight": "800"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
