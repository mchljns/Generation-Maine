{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"title": "Generation Maine",
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": false,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{
					"slug": "navy",
					"name": "Navy (bar, footer, type)",
					"color": "#0F2E4D"
				},
				{
					"slug": "blue",
					"name": "Blue (hero)",
					"color": "#0556A5"
				},
				{
					"slug": "gold",
					"name": "Gold (the accent)",
					"color": "#FAC800"
				},
				{
					"slug": "tint",
					"name": "Light blue (creators field)",
					"color": "#EAF1F8"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#FFFFFF"
				}
			]
		},
		"layout": {
			"contentSize": "1280px",
			"wideSize": "1280px"
		},
		"spacing": {
			"padding": false,
			"margin": false,
			"blockGap": false
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": false,
			"fluid": false,
			"fontSizes": [],
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Bricolage Grotesque (headlines)",
					"fontFamily": "\"Bricolage Grotesque\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Bricolage Grotesque",
							"fontWeight": "800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/bricolage-grotesque-800.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "DM Sans (body)",
					"fontFamily": "\"DM Sans\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "DM Sans",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/dm-sans-var.ttf"
							]
						}
					]
				},
				{
					"slug": "label",
					"name": "Michroma (labels)",
					"fontFamily": "Michroma, Eurostile, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Michroma",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/michroma-regular.ttf"
							]
						}
					]
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "#FFFFFF",
			"text": "#0F2E4D"
		},
		"spacing": {
			"blockGap": "0",
			"padding": {
				"top": "0",
				"right": "0",
				"bottom": "0",
				"left": "0"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"lineHeight": "1.55"
		},
		"elements": {
			"button": {
				"border": {
					"radius": "0"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--label)"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "800"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
